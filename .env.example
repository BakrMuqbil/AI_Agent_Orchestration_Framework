# Copy this file to .env and fill in values for your setup.
# Never commit a real .env file with real API keys.

# --- Model provider -----------------------------------------------------
# One of: ollama | openai | gemini | <a custom provider you registered>
AI_PROVIDER=ollama
AI_MODEL=llama3.1

# Required for openai / gemini; leave unset for ollama.
AI_API_KEY=

# Optional: override the provider's default base URL
# (e.g. point OpenAIProvider at OpenRouter, or Ollama at a remote host).
AI_BASE_URL=

AI_TEMPERATURE=0.3
AI_MAX_TOKENS=800
AI_TIMEOUT_SECONDS=60

# --- Supervisor / execution safety limits --------------------------------
MAX_ITERATIONS=8
MAX_AGENT_CALLS=8
MAX_TOOL_CALLS=20
TASK_TIMEOUT_SECONDS=120

# --- Memory ---------------------------------------------------------------
MEMORY_MAX_HISTORY=20
MEMORY_MAX_SUMMARY_EVENTS=30

# --- Logging / observability -----------------------------------------------
LOG_LEVEL=INFO
ENABLE_STDOUT_EVENT_LOGGING=false
